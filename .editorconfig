root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
charset = utf-8
trim_trailing_whitespace = true

[*.sln]
end_of_line = crlf

[*.vcxproj]
end_of_line = crlf
[*.filters]
end_of_line = crlf
[*.props]
end_of_line = crlf
[*.targets]
end_of_line = crlf

[*.c]
indent_size = 4
tab_width = 4
[*.cpp]
indent_size = 4
tab_width = 4
[*.h]
indent_size = 4
tab_width = 4
[*.hpp]
indent_size = 4
tab_width = 4
